######################################
# Red Hat developer-portal-controller
######################################

FROM registry.redhat.io/ubi9/go-toolset:latest AS builder

ARG BINARY_NAME="manager"
ARG DEVELOPER_PORTAL_CONTROLLER_VERSION=${DEVELOPER_PORTAL_CONTROLLER_VERSION:-unknown}

WORKDIR /workspace
# Copy the Go Modules manifests
COPY developer-portal-controller/go.mod go.mod
COPY developer-portal-controller/go.sum go.sum
# cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN go mod download

# Copy the go source

COPY ./developer-portal-controller/cmd/main.go cmd/main.go
COPY ./developer-portal-controller/api/ api/
COPY ./developer-portal-controller/internal/ internal/
COPY ./developer-portal-controller/LICENSE /licenses/LICENSE

# Set environment variables for cross-compilation
ARG TARGETARCH

# Build arguments aligned with upstream
ARG GIT_SHA=${GIT_SHA:-unknown}
ARG DIRTY=${DIRTY:-unknown}
ARG VERSION=${VERSION:-unknown}

RUN echo "Building with VERSION=${VERSION}, GIT_SHA=${GIT_SHA}, DIRTY=${DIRTY}"

# Build step
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-$(go env GOARCH)} go build -a \
     -ldflags "-X main.version=${VERSION} -X main.gitSHA=${GIT_SHA} -X main.dirty=${DIRTY}" \
	 -o ${BINARY_NAME} cmd/main.go

FROM registry.redhat.io/ubi9/ubi-minimal:latest
ARG VERSION=${VERSION:-unknown}
LABEL version="${VERSION}" \
      com.redhat.component="developer-portal-controller" \
      name="rhcl-1/developer-portal-controller-rhel9" \
      cpe="cpe:/a:redhat:connectivity_link:1::el9" \
      release="${DEVELOPER_PORTAL_CONTROLLER_VERSION}" \
      url="registry.redhat.io/rhcl-1/developer-portal-controller-rhel9" \
      summary="The Developer Portal Controller provides Kubernetes Custom Resource Definitions (CRDs) for managing API products and API keys in a developer portal ecosystem. It integrates with Kuadrant and Gateway API to provide a complete API lifecycle management solution." \
      description="The Developer Portal Controller provides Kubernetes Custom Resource Definitions (CRDs) for managing API products and API keys in a developer portal ecosystem. It integrates with Kuadrant and Gateway API to provide a complete API lifecycle management solution." \
      io.k8s.description="The Developer Portal Controller provides Kubernetes Custom Resource Definitions (CRDs) for managing API products and API keys in a developer portal ecosystem. It integrates with Kuadrant and Gateway API to provide a complete API lifecycle management solution." \
      io.k8s.display-name="Red Hat Connectivity Link Developer Portal Controller" \
      io.openshift.expose-services="" \
      io.openshift.tags="api" \
      vendor="Red Hat, Inc."

ENV BINARY_NAME="manager"
ENV USER_UID=65532
ENV USER_NAME=developer-portal-controller

USER root

# install binary
COPY --from=builder /workspace/${BINARY_NAME} /
RUN chown ${USER_UID} /${BINARY_NAME}

COPY --from=builder /licenses/LICENSE /licenses/LICENSE
RUN chown ${USER_UID} /licenses/LICENSE

ENTRYPOINT ["/manager"]

USER ${USER_UID}
